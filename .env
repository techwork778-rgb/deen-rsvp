# DEEN CRM backend. No trailing slash. The key never goes in the browser.
CRM_API_BASE_URL=http://127.0.0.1:3001

# Same value as RSVP_DASHBOARD_API_KEY on the CRM backend. At least 16 characters.
RSVP_DASHBOARD_API_KEY=

# CEO sign-in on this page. Staff who are not Master use the CRM, which only returns their own RSVPs.
DASHBOARD_ADMIN_PIN=482913

# Optional. When set, a visitor needs ?board=<this key> or the CEO PIN to see the live totals.
# When unset, anyone who can open this server sees totals. Phones still require the CEO PIN.
# DASHBOARD_BOARD_KEY=

PORT=8794